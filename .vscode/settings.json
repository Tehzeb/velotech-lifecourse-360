{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}" },
  "files.exclude": { "**/__pycache__": true },
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" },
  "ai-mlstudio.defaultModelProvider": "github",
  "ai-mlstudio.tracing.enabled": true,
  "ai-mlstudio.tracing.otlpEndpoint": "http://localhost:4318",
  "azureAI.foundry.localModelAlias": "phi-4",
  "velotech.mode": "offline-deterministic-engine"
}
